{
  "id": "wetimer",
  "name": "WeTimer",
  "icon": "Timer",
  "author": "S.N.T",
  "version": "1.0.0",
  "permissions": ["notifications"],
  "code": [
    "return function WeTimer() {",
    "  const [seconds, setSeconds] = React.useState(25 * 60);",
    "  const [running, setRunning] = React.useState(false);",
    "  React.useEffect(() => {",
    "    if (!running) return;",
    "    const timer = setInterval(() => setSeconds(value => { if (value <= 1) { clearInterval(timer); setRunning(false); Sys.notify('WeTimer', 'Focus session complete!'); return 25 * 60; } return value - 1; }), 1000);",
    "    return () => clearInterval(timer);",
    "  }, [running]);",
    "  const minutes = String(Math.floor(seconds / 60)).padStart(2, '0');",
    "  const remaining = String(seconds % 60).padStart(2, '0');",
    "  const reset = () => { setRunning(false); setSeconds(25 * 60); };",
    "  return React.createElement('div', {className: 'h-full flex flex-col items-center justify-center gap-6 bg-gradient-to-br from-indigo-700 to-purple-900 text-white'},",
    "    React.createElement('div', {className: 'text-center'}, React.createElement('div', {className: 'text-sm uppercase tracking-[0.3em] opacity-70'}, 'Focus Session'), React.createElement('div', {className: 'text-7xl font-mono font-bold mt-3'}, minutes + ':' + remaining)),",
    "    React.createElement('div', {className: 'flex gap-3'}, React.createElement('button', {onClick: () => setRunning(value => !value), className: 'px-6 py-3 rounded-xl bg-white text-indigo-700 font-bold'}, running ? 'Pause' : 'Start'), React.createElement('button', {onClick: reset, className: 'px-6 py-3 rounded-xl bg-white/20 font-bold'}, 'Reset'))",
    "  );",
    "}"
  ]
}
